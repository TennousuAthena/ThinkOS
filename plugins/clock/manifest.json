{
  "id": "clock",
  "name": "@name",
  "version": "0.5.0",
  "api": 6,
  "main": "main.lua",
  "permissions": [
    "location"
  ],
  "settings": {
    "seconds": {
      "type": "bool",
      "label": "@setting.seconds",
      "default": false,
      "group": "@group.display"
    },
    "zone1": {
      "type": "choice",
      "label": "@setting.zone1",
      "default": "Asia/Hong_Kong",
      "source": "timezone",
      "group": "@group.world"
    },
    "zone2": {
      "type": "choice",
      "label": "@setting.zone2",
      "default": "Europe/London",
      "source": "timezone",
      "allowEmpty": true,
      "group": "@group.world"
    },
    "zone3": {
      "type": "choice",
      "label": "@setting.zone3",
      "default": "America/New_York",
      "source": "timezone",
      "allowEmpty": true,
      "group": "@group.world"
    },
    "zone4": {
      "type": "choice",
      "label": "@setting.zone4",
      "default": "",
      "source": "timezone",
      "allowEmpty": true,
      "group": "@group.world"
    }
  },
  "pages": [
    {
      "id": "face",
      "view": "views/face.json",
      "title": "@title",
      "roles": [
        "sleep"
      ]
    }
  ],
  "widgets": [
    {
      "id": "now",
      "view": "views/now.json",
      "opens": "face"
    },
    {
      "id": "calendar",
      "view": "views/calendar.json",
      "opens": "face"
    },
    {
      "id": "tile",
      "view": "views/tile.json",
      "opens": "face"
    },
    {
      "id": "desktop",
      "view": "views/desktop.json",
      "opens": "face"
    },
    {
      "id": "date",
      "view": "views/date.json",
      "opens": "face"
    },
    {
      "id": "moon",
      "view": "views/moon.json",
      "opens": "face"
    },
    {
      "id": "sunrise",
      "view": "views/sunrise.json",
      "opens": "face"
    }
  ]
}
