{
  "id": "cast",
  "name": "@name",
  "version": "0.2.0",
  "api": 9,
  "main": "main.lua",
  "permissions": [
    "media"
  ],
  "pages": [
    {
      "id": "home",
      "title": "@page.home",
      "view": "views/home.json"
    },
    {
      "id": "video",
      "title": "@page.video",
      "view": "views/video.json",
      "live": true
    },
    {
      "id": "audio",
      "title": "@page.audio",
      "view": "views/audio.json",
      "live": true
    }
  ],
  "apps": [
    {
      "id": "cast",
      "page": "home",
      "title": "@app.cast",
      "icon": "cast"
    }
  ],
  "widgets": [
    {
      "id": "tile",
      "view": "views/tile.json",
      "opens": "home"
    }
  ],
  "related": [
    "cast.enabled",
    "cast.airplay",
    "cast.airplay_mirror",
    "cast.miracast",
    "cast.name"
  ]
}
