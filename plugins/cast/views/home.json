{
  "layout": "focus",
  "slots": {
    "over": {
      "type": "text",
      "value": "{{headline}}",
      "style": "title"
    },
    "hero": {
      "type": "list",
      "items": "{{rows}}",
      "item": {
        "icon": "{{.icon}}",
        "title": "{{.title}}",
        "subtitle": "{{.subtitle}}",
        "trailing": "{{.trailing}}"
      },
      "tap": "settings"
    },
    "under": {
      "type": "text",
      "value": "{{footer}}",
      "style": "caption"
    }
  }
}
