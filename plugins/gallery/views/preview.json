{
  "template": "glance",
  "relevance": 0.2,
  "children": [
    {
      "type": "image",
      "src": "{{cover}}",
      "fit": "pan",
      "pan": true,
      "interval": "{{config.interval}}",
      "pan_speed": "{{config.pan_speed}}",
      "pan_seconds": "{{config.pan_seconds}}",
      "pan_direction": "{{config.pan_direction}}",
      "weight": 1
    },
    {
      "type": "text",
      "value": "{{coverTitle}}",
      "style": "caption"
    },
    {
      "type": "text",
      "value": "{{coverCredit}}",
      "style": "caption"
    }
  ]
}
