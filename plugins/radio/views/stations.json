{
  "layout": "focus",
  "slots": {
    "over": {
      "type": "tabs",
      "items": "{{tabs}}",
      "current": "{{tab}}",
      "tap": "tab"
    },
    "hero": {
      "type": "list",
      "items": "{{items}}",
      "current": "{{current}}",
      "item": {
        "title": "{{.title}}",
        "subtitle": "{{.subtitle}}",
        "trailing": "{{.trailing}}"
      },
      "tap": "play"
    },
    "under": {
      "type": "text",
      "value": "{{footer}}",
      "style": "caption",
      "tap": "refresh"
    }
  }
}
