{
  "layout": "focus",
  "slots": {
    "over": {
      "type": "text",
      "style": "title",
      "value": "{{heading}}",
      "tap": "cycle"
    },
    "hero": {
      "type": "list",
      "items": "{{items}}",
      "item": {
        "icon": "{{.icon}}",
        "title": "{{.title}}",
        "subtitle": "{{.subtitle}}",
        "trailing": "{{.trailing}}"
      },
      "tap": "play"
    },
    "under": {
      "type": "text",
      "style": "caption",
      "value": "{{footer}}"
    }
  }
}
