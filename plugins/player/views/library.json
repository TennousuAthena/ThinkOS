{
  "layout": "split",
  "slots": {
    "over": {
      "type": "tabs",
      "items": "{{navigation}}",
      "current": "{{navIndex}}",
      "tap": "nav"
    },
    "lead": {
      "children": [
        {
          "type": "image",
          "fit": "contain",
          "src": "{{featureArt}}",
          "weight": 1,
          "tap": "feature"
        },
        {
          "type": "text",
          "style": "title",
          "value": "{{featureHeading}}",
          "tap": "feature"
        },
        {
          "type": "text",
          "style": "caption",
          "value": "{{featureDetail}}"
        },
        {
          "type": "text",
          "style": "caption",
          "value": "{{featureNotice}}",
          "tap": "retry"
        },
        {
          "type": "tabs",
          "items": "{{categories}}",
          "current": "{{tab}}",
          "tap": "tab"
        }
      ]
    },
    "main": {
      "children": [
        {
          "type": "text",
          "style": "caption",
          "value": "{{section}}"
        },
        {
          "type": "text",
          "style": "caption",
          "value": "{{sourceNotice}}",
          "tap": "retry"
        },
        {
          "type": "text",
          "style": "caption",
          "value": "{{playNotice}}"
        },
        {
          "type": "list",
          "items": "{{items}}",
          "current": "{{current}}",
          "item": {
            "icon": "{{.icon}}",
            "title": "{{.title}}",
            "subtitle": "{{.subtitle}}",
            "trailing": "{{.trailing}}",
            "image": "{{.image}}"
          },
          "tap": "play",
          "weight": 1,
          "scrollKey": "{{browseKey}}"
        }
      ]
    },
    "under": {
      "type": "nowplaying",
      "style": "bar",
      "tap": "expand"
    }
  }
}
