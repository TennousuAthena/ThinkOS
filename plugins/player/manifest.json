{
  "id": "player",
  "name": "@name",
  "version": "0.2.0",
  "api": 7,
  "main": "main.lua",
  "permissions": [
    "media",
    "library",
    "network"
  ],
  "settings": {
    "music_dir": {
      "type": "text",
      "label": "@setting.music_dir",
      "default": "/sdcard/Music",
      "maxLength": 512,
      "group": "@group.library"
    },
    "video_dir": {
      "type": "text",
      "label": "@setting.video_dir",
      "default": "/sdcard/Movies",
      "maxLength": 512,
      "group": "@group.library"
    },
    "resume": {
      "type": "bool",
      "label": "@setting.resume",
      "default": true,
      "group": "@group.library"
    },
    "stream_url": {
      "type": "text",
      "label": "@setting.stream_url",
      "default": "",
      "maxLength": 1024,
      "help": "@help.stream_url",
      "group": "@group.streams"
    },
    "playlist_url": {
      "type": "text",
      "label": "@setting.playlist_url",
      "default": "",
      "maxLength": 1024,
      "help": "@help.playlist_url",
      "group": "@group.streams"
    }
  },
  "pages": [
    {
      "id": "library",
      "title": "@page.library",
      "view": "views/library.json"
    },
    {
      "id": "video",
      "title": "@page.video",
      "view": "views/video.json",
      "live": true
    },
    {
      "id": "audio",
      "title": "@page.audio",
      "view": "views/audio.json",
      "live": true
    }
  ],
  "commands": [
    {
      "id": "toggle",
      "phrases": [
        "pause",
        "resume",
        "play"
      ]
    },
    {
      "id": "next",
      "phrases": [
        "next"
      ]
    },
    {
      "id": "prev",
      "phrases": [
        "previous"
      ]
    }
  ],
  "widgets": [
    {
      "id": "now",
      "view": "views/now.json",
      "opens": "library"
    }
  ]
}
