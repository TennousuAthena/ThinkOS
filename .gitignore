# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Android / Gradle 构建产物
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/.cxx/
android/app/release/
# 由 tools/package_plugins.py 生成
android/app/src/main/assets/plugins/
android/local.properties
*.apk
*.aab
# Generated upstream source attachment; keep its hashes and manifests reviewable.
artifacts/lic/LIC-04/*.tar.gz
*.so
*.o

# 签名材料与密钥（绝不提交）
*.jks
*.keystore
keystore.properties
*.p12
*.key
*.pem
# Public Mozilla CA roots that the update transport bundles (certificates only, no key material).
!android/app/src/main/resources/moe/kiwi/thinkos/update/roots.pem
.env
.env.*

# Server 本地运行态
server/thinkos-server
server/config.toml
server/data/
server/logs/

# Python
__pycache__/
*.pyc
.venv/

# 原始逐帧/内存采样由 performance-raw.tar.gz + SHA-256 索引保留；本地解包可直接分析。
artifacts/tiles/**/frames-*.txt
artifacts/tiles/**/memory-*.txt


# 系统层模块的构建产物
system/build/
