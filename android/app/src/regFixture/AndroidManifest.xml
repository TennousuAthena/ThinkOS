<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:label="ThinkOS REG 验收" tools:replace="android:label">
        <!-- Same production MainActivity; this independent test app is never HOME. -->
        <activity android:name="moe.kiwi.thinkos.MainActivity" tools:node="replace"
            android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|locale|layoutDirection"
            android:screenOrientation="fullSensor" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Keep KioskService/RecoveryReceiver intact for ordinary cold-PID recovery.
             An abandoned test install must not launch itself on a physical boot. -->
        <receiver android:name="moe.kiwi.thinkos.shell.BootReceiver" android:enabled="false" />
        <!-- Debug classes/resources are reused explicitly by the build type.
             Mirror their declarations; initWith does not inherit debug manifests. -->
        <activity android:name="moe.kiwi.thinkos.NotificationPreviewActivity" android:exported="true"
            android:permission="android.permission.DUMP" android:excludeFromRecents="true" />
        <activity android:name="moe.kiwi.thinkos.OnboardingPreviewActivity" android:exported="true"
            android:permission="android.permission.DUMP" android:excludeFromRecents="true" />
        <receiver android:name="moe.kiwi.thinkos.DebugReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver android:name="moe.kiwi.thinkos.InstallProbeReceiver" android:exported="false" />
    </application>
</manifest>
