            },
            "timeZone": {
              "type": "boolean"
            },
            "powerOff": {
              "type": "boolean"
            }
          }
        },
        "operationResults": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 16,
          "properties": {
            "update.check": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok"
              ],
              "properties": {
                "ok": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string",
                  "maxLength": 512
                },
                "delayMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30000
                }
              }
            },
            "update.download": {
              "type": "object",
              "additionalProperties": false,
