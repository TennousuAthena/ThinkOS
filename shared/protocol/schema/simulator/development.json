              "additionalProperties": false,
              "properties": {
                "dawn": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "dusk": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "nautical": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dawn": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "dusk": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "astronomical": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dawn": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "dusk": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "golden": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "end": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            },
            "blue": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "end": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "astro.moon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": [
                "number",
                "null"
              ]
            },
            "end": {
              "type": [
                "number",
                "null"
              ]
            },
            "rise": {
              "type": [
                "number",
                "null"
              ]
            },
            "set": {
              "type": [
                "number",
                "null"
              ]
            },
            "transit": {
              "type": [
                "number",
                "null"
              ]
            },
            "azimuth": {
              "type": [
                "number",
                "null"
              ]
            },
            "altitude": {
              "type": [
                "number",
                "null"
              ]
            },
            "timezone": {
              "type": "string",
              "maxLength": 512
            },
            "alwaysUp": {
              "type": "boolean"
            },
            "alwaysDown": {
              "type": "boolean"
            },
            "rises": {
              "type": "array",
              "maxItems": 8,
