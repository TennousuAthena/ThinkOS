              ]
            }
          }
        },
        "androidApps": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 256
              },
              "kind": {
                "const": "android"
              },
              "title": {
                "type": "string",
                "maxLength": 256
              },
              "icon": {
                "type": "string",
                "maxLength": 512
              },
              "image": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        },
        "capabilities": {
          "type": "object",
