                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "transits": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "phase": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "angle": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "illumination": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "ageDays": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "previousNewMoon": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "nextNewMoon": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "nextFirstQuarter": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "nextFullMoon": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "nextLastQuarter": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "name": {
                  "type": "string",
                  "maxLength": 512
                },
                "waxing": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "astro.seasons": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "year": {
