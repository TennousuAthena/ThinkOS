    "ProfileRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": {
          "type": "object"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "reset": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
