{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thinkos:simulator:development:1",
  "title": "Local simulator development channel; independent of device proto=1",
  "$defs": {
    "PluginIdentity": {
      "type": "object",
      "required": [
        "pluginId",
        "digest"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "HttpRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "digest",
        "method",
        "url"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 8192
        },
        "body": {
          "type": "string",
          "maxLength": 1048576
        },
        "headers": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 10000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "sameOrigin": {
          "type": "boolean"
        }
      }
    },
    "DnsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "digest",
        "host"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "host": {
          "type": "string",
          "maxLength": 253
        }
      }
    },
    "StorageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "digest",
        "value"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "value": {
          "type": "object"
        }
      }
    },
    "Environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "enum": [
            "landscape",
            "portrait"
          ],
          "default": "landscape"
        },
        "theme": {
          "enum": [
            "DARK",
            "LIGHT",
            "NIGHT"
          ],
          "default": "DARK"
        },
        "locale": {
          "type": "string",
          "maxLength": 32,
          "default": "zh-Hans"
        },
        "timezone": {
          "type": "string",
          "maxLength": 128,
          "default": "Asia/Hong_Kong"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 1280
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 800
        },
        "density": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4,
          "default": 1.625
        },
        "fontScale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "default": 1
        },
        "lux": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "default": 50
        },
        "presence": {
          "type": "boolean",
          "default": true
        },
        "attention": {
          "enum": [
            "ENGAGED",
            "AWAKE",
            "AMBIENT",
            "ASLEEP"
          ],
          "default": "AWAKE"
        },
        "mode": {
          "enum": [
            "day",
            "redshift",
            "sleep"
          ],
          "default": "day"
        },
        "networkMode": {
          "enum": [
            "live",
            "fixture"
          ],
          "default": "live"
        },
        "systemSimulation": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "default": []
        },
        "now": {
          "type": "number",
          "minimum": 0
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "name": {
              "type": "string",
              "maxLength": 512
            },
            "elevation": {
              "type": "number",
              "minimum": -500,
              "maximum": 10000
            },
            "timezone": {
              "type": "string",
              "maxLength": 512
            },
            "source": {
              "type": "string",
              "maxLength": 512
            }
          }
        },
        "wifi": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "http": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/HttpResponse"
          }
        },
        "library": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "object",
                "maxProperties": 24
              }
            },
            "truncated": {
              "type": "boolean"
            },
            "scanned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "directory": {
              "type": "string",
              "maxLength": 512
            }
          }
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/RegistryCatalogItem"
              }
            },
            "error": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "configured": {
              "type": "boolean"
            },
            "refreshing": {
              "type": "boolean"
            },
            "expired": {
              "type": "boolean"
            }
          }
        },
        "update": {
          "$ref": "../../../schema/update/status.json"
        },
        "cast": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 512
            },
            "dlna": {
              "type": "boolean"
            },
            "airplay": {
              "type": "boolean"
            },
            "mirror": {
              "type": "boolean"
            },
            "miracast": {
              "type": "boolean"
            },
            "miracastModule": {
              "type": "boolean"
            },
            "ip": {
              "type": "string",
              "maxLength": 512
            }
          }
        },
        "onboarding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "integer"
            },
            "active": {
              "type": "boolean"
            },
            "updater": {
              "type": "boolean"
            },
            "done": {
              "type": "boolean"
            },
            "greeting_seconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        "zones": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "type": "array",
            "maxItems": 1024,
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          }
        },
        "astro.sun": {
          "type": "object",
