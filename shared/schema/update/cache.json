{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cache.json",
  "title": "UpdateCachedCatalogDocument",
  "description": "Private atomic cache of original signed catalog bytes. Body/signature are canonical Base64; every read reauthenticates against APK-owned keys and the independent sequence floor. Source and ETag are transport hints, never trust roots.",
  "type": "object",
  "required": ["schema", "channel", "body", "signature", "source"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "integer", "const": 1},
    "channel": {"type": "string", "enum": ["stable", "beta"]},
    "body": {"type": "string", "minLength": 4, "maxLength": 1398104, "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
    "signature": {"type": "string", "minLength": 4, "maxLength": 1368, "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
    "source": {"type": "string", "minLength": 1, "maxLength": 2048},
    "etag": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[ -~]+$"}
  }
}
