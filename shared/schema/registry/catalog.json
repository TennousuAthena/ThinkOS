{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"catalog.json","title":"RegistryCatalog","type":"object","additionalProperties":false,
  "required":["schema","seq","generated","expires","blob_bases","revoked","plugins"],
  "properties":{
    "schema":{"type":"integer","const":1},"seq":{"type":"integer","format":"int64","minimum":1,"maximum":9007199254740991},
    "generated":{"type":"integer","format":"int64","minimum":0,"maximum":9007199254740991},"expires":{"type":"integer","format":"int64","minimum":1,"maximum":9007199254740991},
    "blob_bases":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":2048}},
    "revoked":{"type":"array","maxItems":512,"items":{"$ref":"#/$defs/revoked"}},
    "plugins":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/plugin"}}
  },
  "$defs":{
    "local":{"type":"object","minProperties":1,"additionalProperties":false,"properties":{
      "zh-Hans":{"type":"string","maxLength":256},"zh-Hant":{"type":"string","maxLength":256},"en":{"type":"string","maxLength":256},"es":{"type":"string","maxLength":256},"fr":{"type":"string","maxLength":256},"pt":{"type":"string","maxLength":256},"ru":{"type":"string","maxLength":256},"ar":{"type":"string","maxLength":256},"hi":{"type":"string","maxLength":256},"bn":{"type":"string","maxLength":256},"ur":{"type":"string","maxLength":256}
    }},
    "why":{"title":"RegistryReasons","type":"object","additionalProperties":false,"properties":{
      "network":{"$ref":"#/$defs/local"},"alert":{"$ref":"#/$defs/local"},"media":{"$ref":"#/$defs/local"},"library":{"$ref":"#/$defs/local"},"presence":{"$ref":"#/$defs/local"},"server":{"$ref":"#/$defs/local"},"location":{"$ref":"#/$defs/local"}
    }},
    "release":{"title":"RegistryRelease","type":"object","additionalProperties":false,"required":["version","commit","digest","api","size","permissions","why","apps"],"properties":{
      "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$","maxLength":48},
      "commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"api":{"type":"integer","minimum":1,"maximum":1000},
      "size":{"type":"integer","format":"int64","minimum":1,"maximum":8388608},
      "permissions":{"type":"array","maxItems":7,"uniqueItems":true,"items":{"type":"string","enum":["network","alert","media","library","presence","server","location"]}},
      "why":{"$ref":"#/$defs/why"},"apps":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"}}
    }},
    "plugin":{"title":"RegistryPlugin","type":"object","additionalProperties":false,"required":["id","tier","name","summary","author","repo","license","tags","releases"],"properties":{
      "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"tier":{"type":"string","enum":["official","reviewed","community"]},"name":{"$ref":"#/$defs/local"},"summary":{"$ref":"#/$defs/local"},
      "author":{"type":"string","minLength":1,"maxLength":80},"repo":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$","maxLength":200},"license":{"type":"string","minLength":1,"maxLength":80},
      "tags":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","maxLength":40}},
      "icon":{"type":"string","pattern":"^[0-9a-f]{64}$"},"screenshots":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
      "releases":{"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/release"}}
    }},
    "revoked":{"title":"RegistryRevocation","type":"object","additionalProperties":false,"required":["id","digest","reason"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"reason":{"type":"string","minLength":1,"maxLength":160}}}
  }
}
