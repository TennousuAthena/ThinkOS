{
  "layout": "split",
  "slots": {
    "lead": { "children": [
      { "type": "moon", "path": "moon", "hemisphere": "{{hemisphere}}", "weight": 2 },
      { "type": "progress", "style": "ring", "value": "{{progress}}", "max": 100, "tap": "ring", "weight": 1 },
      { "type": "text", "value": "{{lastTap}}", "style": "caption" }
    ] },
    "main": { "children": [
      { "type": "chart", "style": "area", "values": "{{values}}", "highlight": "{{highlight}}", "weight": 1 },
      { "type": "list", "items": "{{rows}}", "item": { "icon": "{{.icon}}", "title": "{{.title}}", "subtitle": "{{.subtitle}}", "trailing": "{{.trailing}}", "progress": "{{.value}}", "max": 100 }, "tap": "row", "weight": 2 }
    ] }
  }
}
