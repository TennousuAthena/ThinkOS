<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="moe.kiwi.thinkos.externalfixture">
    <uses-sdk android:minSdkVersion="27" android:targetSdkVersion="27" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <application android:label="外部应用测试" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".FixtureActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".FixtureReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
